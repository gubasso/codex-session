---
source: tests/cmd_config_status.rs
expression: stdout
---
active-config-recipe: default
manifest-path:  <TMP>/config/codex-session/config-recipes/default.yaml
account:        default
account-source: lru
group-id:       stable
group-id-source: flag
codex_home:     <TMP>/state/codex-session/accounts/default/groups/stable
accounts:       1 (0 in cooldown)
active-auth:    true
session-root:   <TMP>/state/codex-session
session-source: state
child-bin:      <TMP>/bin/codex
layers:
  base => <TMP>/config/codex-session/configs/base.toml (exists=true)
  work => <TMP>/config/codex-session/configs/work.toml (exists=true)
log.file: <TMP>/state/codex-session
log.verbose: 0
log.mirror-stderr: false
log.format: json
log.stderr-format: auto
sources:
  defaults
  user:    none
  project: none
  env:     CODEX_SESSION_*
  cli:     CliValueOverrides { log: None, child: None, config_recipe: None }
