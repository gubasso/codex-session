#!/usr/bin/env bash
# shellcheck shell=bash
set -euo pipefail

# Resolve real path of this script, following symlinks (portable; no `readlink -f`).
__cs_resolve_root() {
  local src="${BASH_SOURCE[0]}" dir
  while [ -L "$src" ]; do
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    [[ "$src" != /* ]] && src="$dir/$src"
  done
  dir="$(cd -P "$(dirname "$src")" && pwd)"
  # bin/ -> project root
  printf '%s\n' "$(cd -P "$dir/.." && pwd)"
}
CODEX_SESSION_ROOT="$(__cs_resolve_root)"
export CODEX_SESSION_ROOT

# shellcheck source=/dev/null
source "$CODEX_SESSION_ROOT/lib/core.bash"
# shellcheck source=/dev/null
source "$CODEX_SESSION_ROOT/lib/log.bash"
# shellcheck source=/dev/null
source "$CODEX_SESSION_ROOT/lib/config_merge.bash"
# shellcheck source=/dev/null
source "$CODEX_SESSION_ROOT/lib/passthrough.bash"
# shellcheck source=/dev/null
source "$CODEX_SESSION_ROOT/lib/dispatch.bash"

__dispatch "$@"
