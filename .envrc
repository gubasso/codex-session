use flake

# Route each rustc call through the kache of the host. CI enters the devshell
# without direnv, so CI builds without kache. KACHE_DISABLED=1 runs one command
# without it.
export RUSTC_WRAPPER=kache

# Warn about a newer exobrain-tech release than the tag that the hooks pin.
exobrain hooks status || true
# Warn once a day about working-tree copies in the Nix store.
exobrain store-guard --daily || true
