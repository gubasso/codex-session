# EditorConfig: https://editorconfig.org
root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true

# Rust: aligns with rustfmt defaults (tab_spaces = 4, max_width = 100, hard_tabs = false)
# and the official Rust Style Guide.
[*.rs]
indent_style = space
indent_size = 4
max_line_length = 100

# TOML (Cargo.toml, Cargo.lock, rust-toolchain.toml, fixtures): 4-space indent.
[*.toml]
indent_style = space
indent_size = 4

# YAML (.pre-commit-config.yaml, .riptask/config.yaml, GH Actions): 2-space indent.
[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.json]
indent_style = space
indent_size = 2

# Markdown: two trailing spaces denote a hard line break, so don't trim them.
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[*.{bash,sh}]
indent_style = space
indent_size = 2

# Make requires literal tabs for recipe lines.
[Makefile]
indent_style = tab
